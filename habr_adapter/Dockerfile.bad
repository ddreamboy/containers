# Используем последнюю версию, которая в любой момент может обновиться :)
FROM python:latest

WORKDIR /app

# Копируем все файлы приложения, не отделяя зависимости,
# чтобы каждый раз при изменении кода переустанавливались все зависимости
COPY . .

# Делаем парочку лишних RUN'ов на всякий случай,
# обновим пакетный менеджер для уверенности
RUN apt-get update
# ну и curl - полезная вещь, может пригодиться
RUN apt-get install -y curl

# Не торопимся, обновим пакетный менеджер
RUN pip install --upgrade pip
# А потом в новом слое установим зависимости
RUN pip install -r requirements.txt

EXPOSE 7000

# И на десерт запустим приложение из-под root'а, ему можно
CMD ["python", "main.py"]
